# Key properties template for Android release signing
# Copy this file to 'key.properties' in the same directory and fill in your keystore credentials.
# DO NOT commit 'key.properties' or keystore files containing secrets to version control.

storePassword=your_store_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=path/to/upload-keystore.jks
