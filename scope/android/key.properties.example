# Keystore configuration properties template for release builds.
# Copy this file to 'key.properties' in android/ and fill in your actual production keystore credentials.
# WARNING: Never commit key.properties or keystore files (.jks/.keystore) to version control.

storeFile=upload-keystore.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
