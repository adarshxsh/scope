# Release Keystore Properties Example Template
# Copy this file to 'key.properties' in the android/ directory and replace values with your keystore credentials.
# Note: Never commit 'key.properties' or keystore files (.keystore, .jks) to source control.

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=path/to/your/keystore.jks

# Alternatively, environment variables can be set for CI/CD pipelines:
# ANDROID_KEYSTORE_PATH
# ANDROID_KEYSTORE_PASSWORD
# ANDROID_KEY_ALIAS
# ANDROID_KEY_PASSWORD
